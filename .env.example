# 多智能体 AI 金融助手：环境变量
# 将此文件复制为 .env，并填写 API 密钥

# ============================================
# 必填：阿里云百炼（Qwen）API 配置
# ============================================
# 在阿里云百炼控制台创建 API 密钥：
# https://bailian.console.aliyun.com/?apiKey=1#/api-key
DASHSCOPE_API_KEY="your-dashscope-api-key-here"

# 可选：覆盖 Qwen 默认配置
# QWEN_MODEL="qwen3.8-max"
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ============================================
# 可选：API 配置
# ============================================
# 前后端分离部署时使用
# 默认地址：http://localhost:8000
# API_URL="http://localhost:8000"

# 部署到 Streamlit Cloud 时，在 Streamlit secrets 中设置
# API_URL="https://your-backend-service.render.com"

# ============================================
# Qwen 配额与计费
# ============================================
# 配额和价格取决于所选模型及账号。
# 正式使用前请在阿里云百炼控制台核对。

# ============================================
# 可选：部署配置
# ============================================
# PORT=8000
# HOST=0.0.0.0
# DEBUG=False

# ============================================
# 可选：日志配置
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=app.log
